@@ -80,6 +87,32 @@ static audio_init_func_t audio_init_func = NULL;
 static video_renderer_t *video_renderer = NULL;
 static audio_renderer_t *audio_renderer = NULL;
 static logger_t *render_logger = NULL;
+static bool coordinated = getenv("SNES_AIRPLAY_COORDINATED") != NULL;
+static std::mutex renderer_mutex;
+static video_renderer_config_t saved_video_config;
+static audio_renderer_config_t saved_audio_config;
+static int start_renderers() {
+    if ((video_renderer = video_init_func(render_logger, &saved_video_config)) == NULL) return -1;
+    if (saved_audio_config.device != AUDIO_DEVICE_NONE &&
+        (audio_renderer = audio_init_func(render_logger, video_renderer, &saved_audio_config)) == NULL) return -1;
+    if (video_renderer) video_renderer->funcs->start(video_renderer);
+    if (audio_renderer) audio_renderer->funcs->start(audio_renderer);
+    return 0;
+}
+static bool cast_stream_started() {
+    std::lock_guard<std::mutex> guard(renderer_mutex);
+    if (casting_stream) return video_renderer != NULL;
+    if (coordinated) {
+        puts("SNES_AIRPLAY_REQUEST"); fflush(stdout);
+        struct pollfd input = {STDIN_FILENO, POLLIN, 0}; char decision = '0';
+        if (poll(&input, 1, 15000) <= 0 || read(STDIN_FILENO, &decision, 1) != 1 || decision != '1') {
+            running = false; return false;
+        }
+        if (start_renderers() != 0) { running = false; return false; }
+    }
+    casting_stream = true; puts("SNES_AIRPLAY_CONNECTED"); fflush(stdout); return true;
+}
+
 
